/// TrustNotary — Transactional Email (Resend) & Stripe Checkout Integration
/// DarkWave Studios LLC — Copyright 2026
///
/// DDA 42-Doctrine Mapping:
///   [19] System Integrator  - Dispatches confirmation receipts, owner alerts, and Stripe sessions
///   [35] Collapse Detection - Network/key absence degrades gracefully without failing booking

use { escHtml, formatCentralSlot, parseMs, formEncode, attemptAsync, put } from "./shim/lume-interop.mjs"
use { dollarsOf } from "./pricing.lume"

to cleanApiKey(raw, prefix):
    let s = String(raw or "").trim()
    if s.startsWith(prefix + "="):
        set s to s.slice(prefix.length + 1).trim()
    return s

export to resendConfigured():
    return cleanApiKey(process.env.RESEND_API_KEY, "RESEND_API_KEY") != ""

export to stripeConfigured():
    return cleanApiKey(process.env.STRIPE_SECRET_KEY, "STRIPE_SECRET_KEY") != ""

export to sendResendEmail(toAddr, subject, htmlBody, textBody):
    let apiKey = cleanApiKey(process.env.RESEND_API_KEY, "RESEND_API_KEY")
    if apiKey == "" or not toAddr:
        return { ok: false, skipped: true }
    let fromAddr = String(process.env.RESEND_FROM or "TrustNotary <access@dve.tlid.io>")
    to doPost():
        let r = await fetch("https://api.resend.com/emails", {
            method: "POST",
            headers: {
                "Authorization": "Bearer " + apiKey,
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                from: fromAddr,
                to: [String(toAddr).trim()],
                subject: subject,
                html: htmlBody,
                text: textBody
            })
        })
        let j = await r.json()
        return { ok: r.ok, status: r.status, data: j }
    return await attemptAsync(() -> doPost(), { ok: false, error: "resend_unreachable" })

export to notifyBookingCreated(booking, quote, vaultPin, settings, siteUrl):
    let whenStr = formatCentralSlot(parseMs(booking.start_iso), "America/Chicago")
    let portalUrl = String(siteUrl or "") + "/portal"
    let ownerEmail = String(settings.contactEmail or "team@dwsc.io")
    let isRon = booking.modality == "ron"
    let modeText = if isRon then "Remote Online Notarization (Live Webcam)" else "Mobile On-Site Notary (" + booking.address + ")"

    let lines = []
    lines.push("Booking Confirmed: " + booking.ref_code)
    lines.push("Service: " + booking.service_name)
    lines.push("When: " + whenStr)
    lines.push("Mode: " + modeText)
    lines.push("Agreed Total: " + dollarsOf(booking.total_cents))
    lines.push("")
    lines.push("Your Signer Vault Access:")
    lines.push("  Portal: " + portalUrl)
    lines.push("  Reference Code: " + booking.ref_code)
    lines.push("  6-Digit Vault PIN: " + vaultPin)
    lines.push("")
    if isRon:
        lines.push("Before your call: upload your unsigned PDF inside the Signer Vault and have your government photo ID ready.")
    else:
        lines.push("Checklist: please have your printed, unsigned document(s) and valid government photo ID ready when the notary arrives.")

    let h = []
    h.push("<div style=\"font-family:system-ui,-apple-system,sans-serif;max-width:560px;margin:0 auto;padding:24px;background:#0f172a;color:#f8fafc;border-radius:14px\">")
    h.push("<p style=\"color:#d4af37;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;margin:0 0 8px;font-weight:700\">TrustNotary · Tennessee Commissioned Notary</p>")
    h.push("<h2 style=\"margin:0 0 14px;font-size:22px;color:#ffffff\">Appointment Confirmed · " + escHtml(booking.ref_code) + "</h2>")
    h.push("<p style=\"margin:0 0 16px;color:#cbd5e1;line-height:1.6\">Hi " + escHtml(booking.client_name) + ", your notary appointment is locked in for <strong>" + escHtml(whenStr) + "</strong>.</p>")
    h.push("<div style=\"background:#1e293b;padding:16px;border-radius:10px;margin-bottom:16px;border:1px solid rgba(212,175,55,0.28)\">")
    h.push("<p style=\"margin:0 0 6px\"><strong>Service:</strong> " + escHtml(booking.service_name) + "</p>")
    h.push("<p style=\"margin:0 0 6px\"><strong>Format:</strong> " + escHtml(modeText) + "</p>")
    h.push("<p style=\"margin:0\"><strong>Agreed Total:</strong> " + escHtml(dollarsOf(booking.total_cents)) + "</p>")
    h.push("</div>")
    h.push("<div style=\"background:#111827;padding:16px;border-radius:10px;margin-bottom:16px\">")
    h.push("<p style=\"margin:0 0 6px;color:#d4af37;font-weight:700\">Signer Vault Credentials (Upload Docs &amp; Join Link)</p>")
    h.push("<p style=\"margin:0 0 4px\">Reference: <strong>" + escHtml(booking.ref_code) + "</strong></p>")
    h.push("<p style=\"margin:0 0 10px\">6-Digit PIN: <strong style=\"font-size:18px;letter-spacing:0.12em\">" + escHtml(vaultPin) + "</strong></p>")
    h.push("<a href=\"" + escHtml(portalUrl) + "\" style=\"display:inline-block;background:#d4af37;color:#0f172a;text-decoration:none;font-weight:700;padding:10px 18px;border-radius:8px\">Open Signer Vault</a>")
    h.push("</div>")
    h.push("<p style=\"font-size:12px;color:#94a3b8;margin:0\">Questions? Reply directly or email " + escHtml(ownerEmail) + ".</p></div>")
    let html = h.join("")

    let clientSend = await sendResendEmail(booking.client_email, "Confirmed: " + booking.service_name + " (" + booking.ref_code + ")", html, lines.join("\n"))
    let ownerSend = await sendResendEmail(
        ownerEmail,
        "[TrustNotary] New Booking " + booking.ref_code + " · " + dollarsOf(booking.total_cents) + " · " + whenStr,
        "<pre style=\"font:14px/1.5 monospace\">" + escHtml(lines.join("\n") + "\nClient: " + booking.client_name + " | " + booking.client_email + " | " + booking.client_phone) + "</pre>",
        lines.join("\n")
    )
    return { client: clientSend, owner: ownerSend }

export to createStripeCheckoutForBooking(booking, siteUrl):
    let sk = cleanApiKey(process.env.STRIPE_SECRET_KEY, "STRIPE_SECRET_KEY")
    if sk == "":
        return null
    let base = String(siteUrl or "http://localhost:3000")
    let payload = {}
    put(payload, "mode", "payment")
    put(payload, "customer_email", booking.client_email)
    put(payload, "success_url", base + "/portal?ref=" + encodeURIComponent(booking.ref_code) + "&paid=1")
    put(payload, "cancel_url", base + "/portal?ref=" + encodeURIComponent(booking.ref_code))
    put(payload, "line_items[0][price_data][currency]", "usd")
    put(payload, "line_items[0][price_data][unit_amount]", String(booking.total_cents))
    put(payload, "line_items[0][price_data][product_data][name]", booking.service_name + " (" + booking.ref_code + ")")
    put(payload, "line_items[0][quantity]", "1")
    put(payload, "metadata[booking_id]", booking.id)
    put(payload, "metadata[ref_code]", booking.ref_code)

    to postStripe():
        let r = await fetch("https://api.stripe.com/v1/checkout/sessions", {
            method: "POST",
            headers: {
                "Authorization": "Bearer " + sk,
                "Content-Type": "application/x-www-form-urlencoded"
            },
            body: formEncode(payload)
        })
        let j = await r.json()
        return { ok: r.ok, session: j }

    let res = await attemptAsync(() -> postStripe(), { ok: false })

    if res and res.ok and res.session and res.session.url:
        return { id: res.session.id, url: res.session.url }
    return null
