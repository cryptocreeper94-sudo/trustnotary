/// TrustNotary — Tennessee Circular Digital Notary Seal Generator (SVG -> PNG)
/// DarkWave Studios LLC — Copyright 2026
///
/// Generates a clean, statutory-proportioned circular Tennessee Notary Public electronic seal
/// (T.C.A. § 8-16-114 & Online Notary Rules Ch. 1360-07-03) so the owner can download a
/// high-resolution transparent PNG for BlueNotary & the TN Secretary of State portal at $0 cost.
///
/// DDA 42-Doctrine Mapping:
///   [01] Identity Kernel    - Renders certified commission name, county, and state deterministically
///   [31] Verification Layer - Crisp vector geometry suitable for tamper-evident PDF stamping

use { escHtml } from "./shim/lume-interop.mjs"

export to buildSealSvg(opts):
    let o = opts or {}
    let name = escHtml(String(o.name or "RONALD JASON ANDREWS").toUpperCase())
    let county = escHtml(String(o.county or "WILSON COUNTY").toUpperCase())
    let state = escHtml(String(o.state or "STATE OF TENNESSEE").toUpperCase())
    let expires = escHtml(String(o.expires or ""))
    let ink = escHtml(String(o.ink or "#111827"))

    let parts = []
    parts.push("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 520 520\" width=\"520\" height=\"520\">")
    parts.push("<defs>")
    parts.push("<path id=\"topArc\" d=\"M 76,260 A 184,184 0 1,1 444,260\" />")
    parts.push("<path id=\"botArc\" d=\"M 448,260 A 188,188 0 1,1 72,260\" />")
    parts.push("</defs>")
    parts.push("<circle cx=\"260\" cy=\"260\" r=\"244\" fill=\"none\" stroke=\"" + ink + "\" stroke-width=\"10\" />")
    parts.push("<circle cx=\"260\" cy=\"260\" r=\"228\" fill=\"none\" stroke=\"" + ink + "\" stroke-width=\"3\" stroke-dasharray=\"6 5\" />")
    parts.push("<circle cx=\"260\" cy=\"260\" r=\"150\" fill=\"none\" stroke=\"" + ink + "\" stroke-width=\"3.5\" />")
    parts.push("<text fill=\"" + ink + "\" font-family=\"Georgia, 'Times New Roman', serif\" font-size=\"25\" font-weight=\"700\" letter-spacing=\"4\">")
    parts.push("<textPath href=\"#topArc\" startOffset=\"50%\" text-anchor=\"middle\">&#9733; " + state + " &#9733;</textPath>")
    parts.push("</text>")
    parts.push("<text fill=\"" + ink + "\" font-family=\"Georgia, 'Times New Roman', serif\" font-size=\"22\" font-weight=\"700\" letter-spacing=\"3.5\">")
    parts.push("<textPath href=\"#botArc\" startOffset=\"50%\" text-anchor=\"middle\">" + county + " · NOTARY PUBLIC</textPath>")
    parts.push("</text>")
    parts.push("<text x=\"260\" y=\"232\" text-anchor=\"middle\" fill=\"" + ink + "\" font-family=\"'Arial Narrow', Arial, sans-serif\" font-size=\"20\" font-weight=\"800\" letter-spacing=\"1.5\">" + name + "</text>")
    parts.push("<line x1=\"142\" y1=\"248\" x2=\"378\" y2=\"248\" stroke=\"" + ink + "\" stroke-width=\"2\" />")
    parts.push("<text x=\"260\" y=\"278\" text-anchor=\"middle\" fill=\"" + ink + "\" font-family=\"Georgia, serif\" font-size=\"23\" font-weight=\"700\" letter-spacing=\"3\">ONLINE NOTARY</text>")
    if expires != "":
        parts.push("<text x=\"260\" y=\"308\" text-anchor=\"middle\" fill=\"" + ink + "\" font-family=\"Arial, sans-serif\" font-size=\"13\" font-weight=\"700\" letter-spacing=\"1.2\">EXP: " + expires + "</text>")
    else:
        parts.push("<text x=\"260\" y=\"308\" text-anchor=\"middle\" fill=\"" + ink + "\" font-family=\"Arial, sans-serif\" font-size=\"13\" font-weight=\"700\" letter-spacing=\"1.5\">PUBLIC SEAL</text>")
    parts.push("</svg>")
    return parts.join("")
